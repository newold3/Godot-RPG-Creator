[sub_resource type="Resource" id="Resource_8k1bg"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "A sanctuary of nothingness?"
}

[sub_resource type="Resource" id="Resource_kbl5u"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[p]"
}

[sub_resource type="Resource" id="Resource_cxrmk"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[highlight_character mode=0 pos=1]"
}

[sub_resource type="Resource" id="Resource_n2n0v"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "A sanctuary of potential."
}

[sub_resource type="Resource" id="Resource_xaqmg"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "This reality runs on an engine built to be given away."
}

[sub_resource type="Resource" id="Resource_guh6o"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "They call it the \"[color=#f20e0eff]MIT Covenant[/color]\"."
}

[sub_resource type="Resource" id="Resource_4mv46"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[p]"
}

[sub_resource type="Resource" id="Resource_y6nhb"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[highlight_character mode=0 pos=0]"
}

[sub_resource type="Resource" id="Resource_mg7jm"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[shake rate=20 level=5 connected=0]MIT[/shake]? Sounds like a spell."
}

[sub_resource type="Resource" id="Resource_p8uxl"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[p]"
}

[sub_resource type="Resource" id="Resource_ik3hy"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[highlight_character mode=0 pos=1]"
}

[sub_resource type="Resource" id="Resource_c7oc2"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "It’s a promise. It means no one owns the horizon."
}

[sub_resource type="Resource" id="Resource_hyo3o"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "No one owns the logic that governs the tides or the sun."
}

[sub_resource type="Resource" id="Resource_850m1"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "It was forged in solitude so that anyone—even you—could"
}

[sub_resource type="Resource" id="Resource_hhio5"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "take it and build a kingdom without paying a tithe."
}

[sub_resource type="Resource" id="Resource_md2m7"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[p]"
}

[sub_resource type="Resource" id="Resource_apcmq"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[highlight_character mode=0 pos=0]"
}

[sub_resource type="Resource" id="Resource_wa2g7"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "So... I can change this?"
}

[sub_resource type="Resource" id="Resource_iarn2"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[p]"
}

[sub_resource type="Resource" id="Resource_12lnd"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "[highlight_character mode=0 pos=1]"
}

[sub_resource type="Resource" id="Resource_wp5be"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "You can rewrite the physics."
}

[sub_resource type="Resource" id="Resource_0sq6r"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "You can shatter the hierarchy."
}

[sub_resource type="Resource" id="Resource_y1ngj"]
script = ExtResource("5_fiyda")
code = 3
parameters = {

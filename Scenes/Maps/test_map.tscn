}

[sub_resource type="Resource" id="Resource_nt8f1"]
script = ExtResource("5_fiyda")
code = 3
parameters = {
"line": "Quite the opposite. Prisons are built by corporations, walled off by"
}

[sub_resource type="Resource" id="Resource_5c6p4"]

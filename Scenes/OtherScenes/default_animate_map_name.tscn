[sub_resource type="Shader" id="Shader_t1vk1"]
code = "shader_type canvas_item;

// --- UNIFORMS PARA EL ESTILO DRAGON BALL ---
// Color del centro del aura
uniform vec4 color_center : source_color = vec4(1.0, 1.0, 0.0, 1.0); // Amarillo brillante
// Color medio del aura
uniform vec4 color_mid : source_color = vec4(1.0, 0.5, 0.0, 1.0);    // Naranja
// Color del borde del aura
uniform vec4 color_edge : source_color = vec4(1.0, 0.0, 0.0, 1.0);   // Rojo
// Grosor inicial del aura
uniform float aura_width : hint_range(0.0, 50.0) = 15.0;
// Velocidad de la animación
uniform float animation_speed : hint_range(0.0, 10.0) = 4.0;
// Intensidad de la turbulencia (energía caótica)
uniform float turbulence : hint_range(0.0, 5.0) = 2.0;
// Textura de ruido (Cellular/Voronoi es la clave aquí)
uniform sampler2D noise_tex : repeat_enable;
// Textura para la turbulencia (Perlin o Fractal funciona bien)
uniform sampler2D turbulence_tex : repeat_enable;


void fragment() {
    vec4 original_color = texture(TEXTURE, UV);
    float alpha = 0.0;
    
    // 1. Turbulencia: Distorsionamos las UVs del ruido principal con un segundo ruido en movimiento
    vec2 turbulence_uv = UV + vec2(TIME * animation_speed * 0.05, TIME * animation_speed * 0.07);
    float turb = texture(turbulence_tex, turbulence_uv).r;
    vec2 distorted_uv = UV + (turb - 0.5) * turbulence * 0.1;
    
    // 2. Ruido de Celdas Animado: Usamos las UVs distorsionadas para el ruido principal (Voronoi)
    vec2 noise_uv = distorted_uv + vec2(0.0, -TIME * animation_speed * 0.1); // Movimiento hacia arriba
    float noise = texture(noise_tex, noise_uv).r;
    
    // 3. Grosor Dinámico: El grosor del aura se modula por el ruido caótico
    float current_width = aura_width * (1.0 + noise * 0.5);
    vec2 size = TEXTURE_PIXEL_SIZE * current_width;
    
    // Muestreamos la opacidad en múltiples direcciones para expandir el aura
    alpha += texture(TEXTURE, UV + vec2(size.x, 0.0)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, 0.0)).a;
    alpha += texture(TEXTURE, UV + vec2(0.0, size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(0.0, -size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(size.x, size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, -size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(size.x, -size.y)).a;
    alpha += texture(TEXTURE, UV + vec2(-size.x, size.y)).a;
    
    // Suavizamos y limitamos la opacidad expandida
    alpha = smoothstep(0.1, 0.9, alpha / 8.0);
    
    // 4. Gradiente de Color: Mapeamos la opacidad expandida (alpha) al gradiente de 3 colores
    vec4 final_aura_color = color_center;
    final_aura_color = mix(final_aura_color, color_mid, smoothstep(0.1, 0.4, alpha));
    final_aura_color = mix(final_aura_color, color_edge, smoothstep(0.4, 0.8, alpha));
    
    // 5. Combinación Final: Superponemos el texto original nítido
    vec4 final_color = mix(final_aura_color, original_color, original_color.a);
    final_color.a *= alpha; // Usamos el alpha expandido para el aura
    
    COLOR = final_color;
}"


[sub_resource type="GDScript" id="GDScript_vw8cx"]
script/source = "@tool
extends TextureRect


func _ready() -> void:
	play_cursor_animation()


func play_cursor_animation() -> void:
	var t: Tween = create_tween()
	
	t.set_loops()
	
	t.set_parallel(true)
	
	t.tween_property(self, \"scale\", Vector2(1.02, 1.02), 0.2).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	t.tween_property(self, \"scale\", Vector2(0.98, 0.98), 0.4).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT).set_delay(0.2)
	t.tween_property(self, \"modulate\", Color(1.0, 1.0, 1.0, 0.95), 0.4).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	
	t.set_parallel(false)
	
	t.tween_property(self, \"scale\", Vector2(1.0, 1.0), 0.4).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	t.parallel().tween_property(self, \"modulate\", Color(1.0, 1.0, 1.0, 1.0), 0.4).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	
	t.tween_interval(0.15)
"


[sub_resource type="Shader" id="Shader_cuh5i"]
code = "
	shader_type canvas_item;
	uniform bool flip_h = false;
	void fragment() {
		vec2 uv = UV;
		if (flip_h) { uv.x = 1.0 - uv.x; }
		COLOR = texture(TEXTURE, uv);
	}
	"


tooltip_text = "[title]Data Type[/title]
The type of data this event will use to display its scene.

[ul] \"Lpc Event\": Standard LPC Event (created with the character editor).
 \"Image\": Uses an image to create the in-game scene (images should be scaled to a maximum width equal to the tile width).
 \"Custom Scene\": Custom scene that offers more control than a simple image. You can use any scene, but it is recommended to use a scene adapted to LPC assets. The scene can have the function process_event_state, which receives a dictionary with the keys is_moving, direction, and delta, and the function get_shadow_sprites, which returns an array of the sprites used by your scene.[/ul]"
focus_mode = 0
mouse_default_cursor_shape = 2
alignment = 1
selected = 0

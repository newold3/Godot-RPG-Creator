[node name="Launcher" type="OptionButton" parent="HBoxContainer/VBoxContainer/HBoxContainer/VBoxContainer/CustomPanel4/MarginContainer/VBoxContainer2/VBoxContainer4" unique_id=462528779]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "[title]Page Initiator Type[/title]
Choose how you want this page to be activated

[ul] \"Action Button\": The event runs when the player presses the action button while facing the event.
 \"Player Contact\": The event runs when the player walks onto the same tile as the event.
 \"Event Contact\": The event runs when another event moves onto the same tile. You must define which events can trigger it.
 \"Auto-Start\": The event starts automatically as soon as its conditions are met. It blocks player input until it finishes.
 \"Parallel\": The event runs automatically in the background without interrupting player control.
 \"Caller\": The event runs only when triggered directly by another event or script.
 \"Any Contact\": The event runs when the player or other event walks onto the same tile as the event.
 \"Tool\": Projectile(s) or weapon/tool(s) that activates this page.
 \"Signal\": Activated when another event emits the specified signal(s)[/ul]

[Note]: When the trigger is set to \"Player Contact\", \"Event Contact\", or \"Any Contact\", if the \"Passable\" option is enabled, contact will occur upon collision; otherwise, contact will occur when occupying the same tile as this event.

[Note 2]: Events with the \"Caller\" trigger will automatically be converted into an EmptyLPCEvent, with no graphics, no collisions, and fully passable."
focus_mode = 0
mouse_default_cursor_shape = 2
selected = 0
allow_reselect = true
item_count = 9

unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Event and page required to turn in this mission once completed to receive the reward.

[Note]: The page must be a quest page, and you must manually add the event command \"complete mission\" to turn in the mission. If no page is specified, the dialogue defined in \"Success Message\" will be used, and the quest will be turned in immediately upon completion.

[Note2]: Middle Click to erase."
text = "Select page"
clip_text = true


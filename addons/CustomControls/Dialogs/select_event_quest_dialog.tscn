unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Page that will be activated when talking to this event while having this quest active.

[Note]: The page must be a quest page, and you must manually add the event command \"accept mission\" to start the mission. If no page is specified, the dialogue defined in \"Start Message\" will be used, and the quest will be accepted immediately upon completion.

[Note2]: Middle Click to erase."
text = "Select page"
clip_text = true


unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Common Event ID triggered automatically when this quest is successfully completed.
This event fires universally regardless of whether the quest delivery was automatic or manual.

\"WARNING\": Do not include quest-altering commands within this Common Event to avoid conflicts with the Quest Manager.

[Note]: Middle Click = Erase Global Event"
text = "On Complete Call Common Event - None"
clip_text = true

[node name="OnFailCallCommonEvent" parent="MarginContainer/VBoxContainer" unique_id=943217175 instance=ExtResource("3_sc7n4")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Common Event ID triggered automatically when this quest is failed or canceled.
This event fires universally as soon as the quest enters a failed state.

\"WARNING\": Do not include quest-altering commands within this Common Event to avoid conflicts with the Quest Manager.

[Note]: Middle Click = Erase Global Event"
text = "On Fail Call Common Event     - None"
clip_text = true


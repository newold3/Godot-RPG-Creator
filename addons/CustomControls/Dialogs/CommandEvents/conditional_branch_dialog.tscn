[sub_resource type="GDScript" id="GDScript_o4ayx"]
script/source = "@tool
extends Button


@export var target: Node


func _ready() -> void:
	add_to_group(\"collapse_button\")
	toggled.connect(_on_toggled)


func _on_toggled(value: bool) -> void:
	if value:
		text = \"◀\"
	else:
		text = \"▼\"
	
	if target:
		target.visible = !value
"


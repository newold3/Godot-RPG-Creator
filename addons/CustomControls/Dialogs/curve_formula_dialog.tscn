[node name="HelpLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxContainer/HBoxContainer2/VBoxContainer2" unique_id=1499659782]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Available Symbols and Variables:
---------------------------------
• level (or i)      		: Current processed level (from 0 to max_level)
• max_level (or n)  		: Maximum available level (total_elements - 1)
• min_val          			: Minimum elevation value (e.g., 1)
• max_val         		 	: Maximum elevation value (e.g., 25000)

Available Mathematical Functions:
---------------------------------
• pow(base, exp)   		: Power (e.g., pow(level, 2))
• sqrt(x)         		: Square root
• log(x)           		: Natural logarithm
• exp(x)           		: Exponential e^x
• sin(x), cos(x)   		: Trigonometric functions
• abs(x)          		: Absolute value
• clamp(x, min, max)	: Restricts x to the range between min and max
• lerp(a, b, t)    		: Linear interpolation between a and b using t (0 to 1)"
mouse_filter = 1
mouse_default_cursor_shape = 16
text = "❔Help"
horizontal_alignment = 2


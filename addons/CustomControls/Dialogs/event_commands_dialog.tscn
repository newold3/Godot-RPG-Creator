[node name="Button132" parent="VBoxContainer/MarginContainer/VBoxContainer/ButtonsContainer/GroupButtons3/MarginContainer/Tab3/PanelContainer5/VBoxContainer2/MarginContainer/HFlowContainer" unique_id=1551850959 instance=ExtResource("4_vlbtw")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
tooltip_text = "[title]Set Tile State[/title]
Change the active state of a tile.
A tile can only be active if it has a passability resource. When deactivated, the tile becomes fully passable, and if it has the “Keep Events On Top” property, that property will also be disabled.
(This is useful, for example, for creating a bridge that you can walk under when the tile is deactivated, or over when it is activated.)
"
theme_override_styles/normal = SubResource("StyleBoxTexture_tw82q")
theme_override_styles/pressed = SubResource("StyleBoxTexture_166ym")
theme_override_styles/hover = SubResource("StyleBoxTexture_el2kb")

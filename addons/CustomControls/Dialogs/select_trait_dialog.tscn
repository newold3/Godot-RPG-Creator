tooltip_text = "[title]Skill Special Flag[/title]
[ul] \"MP Cost Down\": Reduces or increases the MP cost of skills by a percentage ranging from 0 to 10,000%.
 \"Double Cast Chance\": Reduces or increases the probability of a skill being cast twice by a percentage ranging from 0 to 10,000% (the base probability of casting a skill twice in a row is 0.01%).[/ul]"
mouse_filter = 2
max_value = 10000.0
editable = false
disabled = true
_custom_value = 0.0


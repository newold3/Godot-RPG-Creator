[node name="C22-1" type="CheckBox" parent="MarginContainer/HBoxContainer/ButtonsContainer/FilterSmoothContainer/MarginContainer/VBoxContainer/Abilities/Parent/HBoxContainer4" unique_id=1146327284]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "[title]Special Flag[/title]
Grants special traits related to actions during battle.

[table=2]
[cell][color=#91e1ff] Auto Battle: [/color][/cell] [cell]Characters will perform actions automatically without taking commands from the player.[/cell]
[cell][color=#91e1ff] Guard Decreases: [/color][/cell] [cell]Decreases the amount of damage taken by a fixed rate.[/cell]
[cell][color=#91e1ff] Substitute: [/color][/cell] [cell]Take damage in place of an ally when they are attacked when their HP is low.[/cell]
[cell][color=#91e1ff] Preserve TP: [/color][/cell] [cell]Accumulated TP will be preserved for the next battle. By default, TP will be reset each battle, and the amount of TP that each character has at the start of battle will be decided randomly.[/cell]
[/table]"
mouse_default_cursor_shape = 2
button_group = SubResource("ButtonGroup_y1kif")
text = "Special Flag"

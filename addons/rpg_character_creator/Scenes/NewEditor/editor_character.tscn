[node name="SaveMode" parent="VBoxContainer/VBoxContainer/HBoxContainer/PanelContainer2/VBoxContainer2/SaveAndImportContainer/SaveTabContainer/Save Options/MarginContainer/HBoxContainer3" unique_id=148385507 instance=ExtResource("2_1xyyu")]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
tooltip_text = "Save Modes:

[ul]
\"Save Character\": Saves the playable character with all equipped gear and body parts, regardless of any layer visibility changes made in the editor.

\"Save Event\": Saves the non-playable character with all equipped gear and body parts, regardless of any layer visibility changes made in the editor.

\"Set\": Saves the installed gear pieces into a configuration file. Body parts are ignored. When applied to a character, only the defined gear parts update their visuals.

\"Save Costume\": Saves the final visual configuration shown in the editor, including manually hidden layers. When applied to a character, all of its visuals are replaced by the costume.
[/ul]

[Note]: Some layers may be automatically hidden by equipped items (for example, a helmet hiding the hair). These automatic visibility changes are respected by all save modes. Manually hidden layers, however, only affect Save Costume. Other save modes ignore manual layer visibility."
focus_mode = 0
selected = 0
item_count = 4
